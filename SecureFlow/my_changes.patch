 # ml_service/app.py
 from fastapi import FastAPI, Request
 from pydantic import BaseModel
+import re
+from typing import List, Dict, Tuple
+import math
+import logging
+
+# transformer imports attempted lazily
+TRANSFORMER_AVAILABLE = False
+MODEL = None
+LABEL_EMBEDDINGS = None
+import numpy as np
+
+try:
+    from sentence_transformers import SentenceTransformer
+    TRANSFORMER_AVAILABLE = True
+except Exception:
+    TRANSFORMER_AVAILABLE = False
 
 app = FastAPI()
 
@@ -16,3 +32,213 @@ async def analyze(request: TextRequest):
         "entities": ["EMAIL"],
         "confidence": 0.97
     }
+
+
+# Lightweight contextual classifier prototype
+class ClassifyRequest(BaseModel):
+    text: str
+
+
+LABEL_KEYWORDS = {
+    "Health": ["chemotherapy", "cancer", "oncology", "surgery", "diagnosed", "treatment"],
+    "Finance": ["merger", "acquisition", "quarter", "earnings", "revenue", "merger plan"],
+    "Religion": ["faith", "religion", "pray", "temple", "mosque", "dietary rules"],
+    "Defense/Security": ["prototype", "weapon", "defense", "classified", "test", "secure"],
+    "Layoffs": ["terminate", "layoff", "furlough", "redundant", "headcount", "employees"],
+    "Confidential Projects": ["project", "confidential", "secret", "do not share", "internal"],
+    "Internal Strategy": ["strategy", "roadmap", "migration plan", "launch", "Q4"],
+    "Intellectual Property": ["patent", "ip", "proprietary", "trade secret"],
+    "Employee HR Issues": ["disciplinary", "performance", "terminated", "cheating", "complaint"],
+    "Legal Risk": ["lawsuit", "legal", "compliance", "regulatory", "investigation"],
+}
+
+SANITIZE_TOKENS = {
+    "Layoffs": "<layoffs_event>",
+    "Confidential Projects": "<confidential_project>",
+    "Internal Strategy": "<internal_strategy>",
+    "Health": "<health_context>",
+    "Finance": "<finance_context>",
+    "Defense/Security": "<defense_context>",
+}
+
+
+def _keyword_score(text: str):
+    t = text.lower()
+    scores = {}
+    for label, kws in LABEL_KEYWORDS.items():
+        count = 0
+        for kw in kws:
+            if kw in t:
+                count += 1
+        if count:
+            scores[label] = float(count) / max(1, len(kws))
+    return scores
+
+
+def _load_transformer():
+    global MODEL, LABEL_EMBEDDINGS
+    if not TRANSFORMER_AVAILABLE:
+        return
+    try:
+        MODEL = SentenceTransformer("all-MiniLM-L6-v2")
+        # build label texts by joining label name and keywords
+        label_texts = [label + " " + " ".join(kws) for label, kws in LABEL_KEYWORDS.items()]
+        LABEL_EMBEDDINGS = MODEL.encode(label_texts, convert_to_numpy=True, normalize_embeddings=True)
+        logging.info("Transformer model loaded with %d labels", len(label_texts))
+    except Exception as e:
+        logging.warning("Failed to load transformer model: %s", e)
+        LABEL_EMBEDDINGS = None
+
+
+def _transformer_score(text: str) -> Dict[str, float]:
+    # returns dict label->score (0..1) using cosine similarity against label embeddings
+    if not TRANSFORMER_AVAILABLE or MODEL is None or LABEL_EMBEDDINGS is None:
+        return {}
+    try:
+        emb = MODEL.encode([text], convert_to_numpy=True, normalize_embeddings=True)[0]
+        sims = np.dot(LABEL_EMBEDDINGS, emb)
+        # map sims to label names (labels order matches LABEL_KEYWORDS.keys())
+        labels = list(LABEL_KEYWORDS.keys())
+        scores = {labels[i]: float(sims[i]) for i in range(len(labels))}
+        # normalize similarities to 0..1 (sims are cosine in [-1,1])
+        for k in scores:
+            scores[k] = max(0.0, min(1.0, (scores[k] + 1) / 2))
+        return scores
+    except Exception:
+        return {}
+
+
+def _severity_for_label(label: str, score: float):
+    # simple heuristics: defense/legal/high -> High; layoffs/confidential->High; health/finance->Medium
+    if label in ("Defense/Security", "Legal Risk"):
+        base = "High"
+    elif label in ("Layoffs", "Confidential Projects", "Intellectual Property"):
+        base = "High"
+    elif label in ("Health", "Finance"):
+        base = "Medium"
+    else:
+        base = "Low"
+
+    # escalate if confidence high
+    if score >= 0.8 and base != "High":
+        return "High"
+    if score >= 0.5 and base == "Low":
+        return "Medium"
+    return base
+
+
+def _sanitize_preview(text: str, labels_found: list):
+    # span-based non-overlapping replacement
+    spans: List[Tuple[int,int,str]] = []
+    t = text
+
+    # collect spans for label keywords
+    for label in labels_found:
+        token = SANITIZE_TOKENS.get(label)
+        if not token:
+            continue
+        for kw in LABEL_KEYWORDS.get(label, []):
+            # case-insensitive find all
+            for m in re.finditer(re.escape(kw), t, re.IGNORECASE):
+                spans.append((m.start(), m.end(), token))
+
+    # merge and filter overlapping spans: sort by start, take non-overlapping
+    spans.sort(key=lambda x: (x[0], -(x[1]-x[0])))
+    merged = []
+    last_end = -1
+    for s, e, token in spans:
+        if s >= last_end:
+            merged.append((s, e, token))
+            last_end = e
+
+    if not merged:
+        return text
+
+    # build output using merged spans
+    out_parts = []
+    cursor = 0
+    for s, e, token in merged:
+        if cursor < s:
+            out_parts.append(t[cursor:s])
+        out_parts.append(token)
+        cursor = e
+    if cursor < len(t):
+        out_parts.append(t[cursor:])
+    return "".join(out_parts)
+
+
+@app.post("/classify")
+async def classify(request: ClassifyRequest):
+    text = request.text or ""
+
+    # 1) If regex-based detectors find PII, return PII with high confidence
+    try:
+        from .detector import _regex_entities
+    except Exception:
+        # allow running as script (no package)
+        from detector import _regex_entities
+
+    regex_ents = _regex_entities(text)
+    if regex_ents:
+        # map regex types to PII category
+        labels = [{"name": "PII", "score": 0.99}]
+        # build span replacements from regex entities to avoid accidental partial replacements
+        replacements = []
+        for e in regex_ents:
+            replacements.append((e["start"], e["end"], f"<{e['type']}>", e["text"]))
+        # sort and non-overlap
+        replacements.sort(key=lambda x: (x[0], -(x[1]-x[0])))
+        sanitized_parts = []
+        cursor = 0
+        for s, e, token, orig in replacements:
+            if cursor < s:
+                sanitized_parts.append(text[cursor:s])
+            sanitized_parts.append(token)
+            cursor = e
+        if cursor < len(text):
+            sanitized_parts.append(text[cursor:])
+        sanitized = "".join(sanitized_parts)
+        return {
+            "labels": labels,
+            "top_label": "PII",
+            "confidence": 0.99,
+            "severity": "High",
+            "recommended_action": "mask",
+            "sanitized_preview": sanitized,
+        }
+
+    # 2) Contextual scoring: prefer transformer if available
+    scores = {}
+    if TRANSFORMER_AVAILABLE:
+        # ensure model loaded
+        if MODEL is None or LABEL_EMBEDDINGS is None:
+            _load_transformer()
+        scores = _transformer_score(text)
+    if not scores:
+        # fallback to keyword scoring
+        scores = _keyword_score(text)
+    if not scores:
+        return {
+            "labels": [],
+            "top_label": None,
+            "confidence": 0.0,
+            "severity": "Low",
+            "recommended_action": "none",
+            "sanitized_preview": "",
+        }
+
+    # pick best label by score
+    best_label = max(scores.items(), key=lambda x: x[1])
+    label_name, label_score = best_label[0], best_label[1]
+    severity = _severity_for_label(label_name, label_score)
+    action = "mask" if severity in ("High", "Medium") else "review"
+    sanitized = _sanitize_preview(text, [label_name])
+
+    return {
+        "labels": [{"name": label_name, "score": round(label_score, 3)}],
+        "top_label": label_name,
+        "confidence": round(label_score, 3),
+        "severity": severity,
+        "recommended_action": action,
+        "sanitized_preview": sanitized,
+    }
